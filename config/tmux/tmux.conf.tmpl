# agentic-hub tmux starter config.
# STARTER TEMPLATE. This awaits the real port from the author's Linux machine.
# Rendered by setup/setup.sh or setup/setup.ps1 into ~/.config/tmux/tmux.conf.

# Prefix: C-a is easier to reach than the default C-b.
unbind C-b
set -g prefix C-a
bind C-a send-prefix

# Mouse support for pane resize and scroll.
set -g mouse on

# Truecolor. The overrides line tells tmux the outer terminal supports RGB.
set -g default-terminal "tmux-256color"
set -ga terminal-overrides ",*256col*:Tc"

# Sane defaults.
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on
set -g history-limit 50000
set -sg escape-time 10
set -g focus-events on

# Minimal status line with the hub accent color.
set -g status-style "bg=default,fg={{accent_color}}"
set -g status-left "#[bold] {{user_name}} #[default]| "
set -g status-right "#[fg={{accent_color_secondary}}]%Y-%m-%d %H:%M"

# ===================================================================
# SECTION 8: Command Palette -- fzf fuzzy picker (Prefix + Space)
# ===================================================================
# A floating popup with 51 searchable tmux actions. Type to filter,
# Enter to execute, Esc to cancel. Requires fzf. When fzf is absent,
# the script prints an install hint instead.
bind Space display-popup \
  -E \
  -T " ⬢  Command Palette " \
  -w 72% \
  -h 60% \
  -x C \
  -y C \
  -b heavy \
  -S "fg={{accent_color}}" \
  "~/.config/tmux/scripts/palette.sh"

# Chrysaki theme include. The ext-tmux-theme component clones the theme.
# The if-shell test keeps tmux quiet when the theme is absent.
if-shell "test -f {{tmux_theme_conf}}" "source-file {{tmux_theme_conf}}"
