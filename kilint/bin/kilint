#!/usr/bin/env python3
"""Executable shim for kilint.

Runs the CLI straight from the checkout, with no install step. The package
directory already occupies the name `kilint` next to this file's parent, so the
shim lives in `bin/`. Symlink it onto PATH, for example:

    ln -sf "$PWD/bin/kilint" ~/.local/bin/kilint
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from kilint.__main__ import run  # noqa: E402

if __name__ == "__main__":
    sys.exit(run())
