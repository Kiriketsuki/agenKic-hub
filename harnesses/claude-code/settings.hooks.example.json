{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/gh-check-before-create.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "bash \"$HOME/.claude/hooks/pre-push-auth.sh\"",
            "timeout": 15
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "bash \"$HOME/.claude/hooks/lint-precommit.sh\"",
            "timeout": 120
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "bash \"$HOME/.claude/hooks/large-file-check.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Agent|TeamCreate",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/agent-route-suggest.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/context7-suggest.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/python-syntax-check.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*playwright.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/playwright-reaper.sh\" mark",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/preflight-check.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/playwright-reaper.sh\" sweep",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/stop-verify-gate.sh\"",
            "timeout": 300
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/playwright-reaper.sh\" sweep",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
